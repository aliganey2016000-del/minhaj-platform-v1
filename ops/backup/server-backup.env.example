# Copy to /etc/server-backup.env, then:  chmod 600 /etc/server-backup.env
# NEVER commit the real file.

# --- What to back up -------------------------------------------------------
MONGODB_URI="mongodb://user:pass@127.0.0.1:27017/minhaj?authSource=admin"
# Directories archived into files-<stamp>.tar.gz (space separated, absolute)
FILES_PATHS="/var/www /opt/minhaj-platform-v1/apps/backend/uploads"
# Excluded from the files archive (tar patterns)
FILES_EXCLUDE="node_modules .git dist build *.log"
# Config archived into config-<stamp>.tar.gz (missing paths are skipped with a warning)
CONFIG_PATHS="/opt/minhaj-platform-v1/apps/backend/.env /etc/nginx /etc/apache2 /opt/minhaj-platform-v1/docker-compose.yml /etc/cron.d"

# --- Destination -----------------------------------------------------------
# An rclone *crypt* remote that wraps Google Drive folder "server-backup"
RCLONE_REMOTE="gdrive-crypt:"
RCLONE_CONFIG="/root/.config/rclone/rclone.conf"
KEEP_BACKUPS=14

# --- Alerts (set at least one) ---------------------------------------------
TELEGRAM_BOT_TOKEN=""
TELEGRAM_CHAT_ID=""
ALERT_EMAIL=""            # needs a working `mail`/`mailx` (e.g. msmtp)

# --- Misc ------------------------------------------------------------------
WORK_DIR="/var/backups/server-backup-tmp"
LOG_DIR="/var/log/server-backup"
LOG_KEEP_DAYS=30
MIN_FREE_MB=2048          # abort if the work dir has less free space than this
